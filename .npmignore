# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# We only need distribution files
!dist
src/
docs/

# Documentation
.storybook

# Tools and tests. Anchored to the root, so dist/tools (the contrast checker) is still published.
/tools/
/test/

# Workspaces
*.code-workspace
